#!/bin/sh
set -e
# Login and lock screen settings go in the greeter's /etc config file,
# which dpkg keeps on upgrades (the /usr/share conf.d file gets replaced)
F=/etc/lightdm/lightdm-gtk-greeter.conf
grep -q '^# Krelboyne Go' $F || sed -i '/^\[greeter\]/a # Krelboyne Go\
background=/usr/share/krelgo/branding/login.jpg\
theme-name=Arc-Dark\
# Text size for the Go'"'"'s 8.8 inch screen\
xft-dpi=160\
# Onboard on the login and lock screen (no keyboard on the Go), full width at the bottom\
keyboard=onboard\
a11y-states=+keyboard\
keyboard-position=50%,center -0;100% 35%' $F
